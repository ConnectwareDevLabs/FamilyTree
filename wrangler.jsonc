{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "familytree",
  "main": "src/index.js",
  "compatibility_date": "2026-10-03",
  "build": {
    "command": "node scripts/build-static.js"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "familytree-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "env": {
    "dev": {
      "name": "familytree-dev",
      "build": {
        "command": "node scripts/build-static.js"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "familytree-db",
          "database_id": "00000000-0000-0000-0000-000000000000"
        }
      ]
    }
  }
}
