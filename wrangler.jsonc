{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "familytree",
  "main": "src/index.js",
  "compatibility_date": "2026-10-03",
  "build": {
    "command": "node scripts/build-static.js"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "env": {
    "dev": {
      "name": "familytree-dev",
      "build": {
        "command": "node scripts/build-static.js"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      }
    }
  }
}
